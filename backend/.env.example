# Server port
PORT=4000

# MongoDB connection string (Local MongoDB or MongoDB Atlas URI for Render)
# Example local: mongodb://127.0.0.1:27017/edgelink_seo
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edgelink_seo
MONGODB_URI=

# Allowed frontend origin for CORS (e.g. http://localhost:3000 or https://your-frontend.onrender.com)
FRONTEND_URL=http://localhost:3000

# Public URL of this backend or app for report links in notifications
APP_URL=http://localhost:4000

# Mock toggle: set to "true" to use deterministic mocks for PageSpeed, GSC, DataForSEO, and Twilio/Email
USE_MOCKS=true

# Anthropic Claude API key for Step 8 Master SEO Audit synthesis (claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Redis connection URL for BullMQ queue "seo-audit-jobs" (falls back to in-process async queue when unset)
REDIS_URL=

# Shared secret protecting GET /api/cron/audits (Authorization: Bearer <CRON_SECRET> or x-cron-secret)
CRON_SECRET=

# Optional live API credentials when USE_MOCKS=false
PAGESPEED_API_KEY=
GSC_ACCESS_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
